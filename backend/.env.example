# Copy to .env and fill in. NEVER commit .env
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/myday
# At least 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Comma separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:5000
# Optional TTF (e.g. Noto Sans Bengali) so Bangla text renders in PDF
PDF_FONT_PATH=
